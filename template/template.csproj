<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>CleanGraphQLApi.Template</PackageId>
    <Title>Clean GraphQL API Template</Title>
    <Authors>Stephen Walsh</Authors>
    <Description>A dotnet new template for a GraphQL API using GraphQL for .NET, built with a streamlined Clean Architecture on .NET 10.</Description>
    <PackageTags>dotnet;csharp;dotnet-template;template;clean-architecture;cqrs;mediator;fluentvalidation;mapperly;entity-framework-core;docker;aspnetcore;graphql;graphql-dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/stphnwlsh/CleanGraphQLApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stphnwlsh/CleanGraphQLApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>docs/LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>docs/NUGET.md</PackageReadmeFile>
    <PackageIcon>images/icon.png</PackageIcon>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5118</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsTestProject>false</IsTestProject>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../**/*" Exclude="../**/bin/**;../**/obj/**;../**/*.user;../**/*.lock.json;../**/.DS_Store;../**/.git/**;../**/.github/**;../**/.vs/**;../LICENSE.md;../**/*.gitattributes;../NUGET.md;../README.md;../CONTRIBUTING.md;../CODE_OF_CONDUCT.md;../SECURITY.md;../SUPPORT.md;../docs/sponsor.jpg;../**/*.gitignore;../**/nuget.config;../template/**;../**/.dockerignore;../**/.editorconfig;../icon.png;" />
    <None Include="../icon.png" Pack="true" PackagePath="images/" />
    <None Include="../LICENSE.md" Pack="true" PackagePath="docs/" />
    <None Include="../NUGET.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
